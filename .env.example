# 実Backlogスペースを使う結合テスト用の設定。
# .env にコピーして値を埋める（.env はgit管理外）。mise を使う場合は
# mise.local.toml の [env] セクションでも同じ変数を設定できる（同じくgit管理外）。
#
#   pnpm test:integration
#
# 未設定の場合、結合テストはスキップされる。

# テスト用スペースのドメイン（example.backlog.jp / example.backlog.com 形式）
BACKLOG_DOMAIN=

# テスト用スペースのAPIキー（Backlogの「個人設定 → API」で発行）
# 本番データのあるスペースのキーは使わないこと
BACKLOG_API_KEY=
